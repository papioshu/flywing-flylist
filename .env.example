# ---- Front end (baked into the static build; NOT secret) ----
# Full URL of the deployed Edge Function. Local dev: http://localhost:8787/allowlist
VITE_API_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1/allowlist
# Optional but recommended for mobile wallets outside an in-app browser. Free at https://cloud.reown.com
VITE_WALLETCONNECT_PROJECT_ID=

# ---- Local dev API only (npm run dev:api). In production these are Supabase function secrets. ----
ADMIN_WALLETS=0xYourAdminWallet
# ALLOWED_ORIGINS=http://localhost:5173
# IP_HASH_SALT=any-16+-char-string
